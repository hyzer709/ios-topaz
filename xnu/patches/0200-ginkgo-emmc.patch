+
+/* ---- ginkgo eMMC backend (SDHCI 3.00, 32-bit ADMA2) ---- */
+
+#define EM_BLOCK        0x04    /* [15:0] block size, [31:16] block count */
+#define EM_ARG          0x08
+#define EM_XFER_CMD     0x0c    /* [15:0] transfer mode, [31:16] command */
+#define EM_RESP0        0x10
+#define EM_PRESENT      0x24
+#define EM_HOSTCTL      0x28    /* [7:0] host control 1, [15:8] power */
+#define EM_CLOCK        0x2c    /* [15:0] clock, [23:16] timeout, [31:24] reset */
+#define EM_INT_STAT     0x30
+#define EM_INT_EN       0x34
+#define EM_SIG_EN       0x38
+#define EM_CAPS         0x40
+#define EM_ADMA_LO      0x58
+#define EM_ADMA_HI      0x5c
+#define EM_VERSION      0xfc
+#define EM_PWRCTL_STAT  0x240   /* sdhci-msm v5 power-control handshake */
+#define EM_PWRCTL_CLEAR 0x248
+#define EM_PWRCTL_CTL   0x24c
+
+#define EM_CMD_INHIBIT  (1u << 0)
+#define EM_DAT_INHIBIT  (1u << 1)
+#define EM_DAT0         (1u << 20)
+#define EM_INT_CMD      (1u << 0)
+#define EM_INT_XFER     (1u << 1)
+#define EM_INT_ERR      (1u << 15)
+
+#define EM_R136         0x01
+#define EM_R48          0x02
+#define EM_R48B         0x03
+#define EM_CRC          0x08
+#define EM_IDX          0x10
+#define EM_DATA         0x20
+
+#define EM_M_DMA        (1u << 0)
+#define EM_M_BLKCNT     (1u << 1)
+#define EM_M_ACMD12     (1u << 2)
+#define EM_M_READ       (1u << 4)
+#define EM_M_MULTI      (1u << 5)
+
+#define EM_ADMA_CHUNK   0x8000u
+#define EM_R1_ERRORS    0xfdf90008u     /* R1 card status error bits */
+
+struct em_desc {
+	uint16_t attr, len;
+	uint32_t addr;
+};
+
+static void
+emmc_reset_lines(void)
+{
+	ufs_wr(EM_CLOCK, ufs_rd(EM_CLOCK) | (6u << 24));
+	for (int i = 0; i < 100000 && ((ufs_rd(EM_CLOCK) >> 24) & 6); i++) {
+		delay(1);
+	}
+	ufs_wr(EM_INT_STAT, 0xffffffff);
+}
+
+/* Wait for mask (or an error) in the interrupt status: 0, ETIMEDOUT or EIO. */
+static int
+emmc_wait(uint32_t mask, uint64_t timeout_ns, uint32_t *st)
+{
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(timeout_ns, &deadline);
+	deadline += mach_absolute_time();
+	uint32_t s;
+	while (!((s = ufs_rd(EM_INT_STAT)) & (mask | EM_INT_ERR))) {
+		if (mach_absolute_time() > deadline) {
+			*st = s;
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	*st = s;
+	return (s & EM_INT_ERR) ? EIO : 0;
+}
+
+static int
+emmc_idle(uint32_t bits)
+{
+	for (int i = 0; i < 500000; i++) {
+		if (!(ufs_rd(EM_PRESENT) & bits)) {
+			return 0;
+		}
+		delay(1);
+	}
+	return ETIMEDOUT;
+}
+
+static void
+emmc_busy_end(void)
+{
+	uint32_t st;
+	(void)emmc_wait(EM_INT_XFER, 2ull * NSEC_PER_SEC, &st);
+	ufs_wr(EM_INT_STAT, 0xffffffff);
+	for (int i = 0; i < 2000000 && !(ufs_rd(EM_PRESENT) & EM_DAT0); i++) {
+		delay(1);
+	}
+}
+
+/* A command without data. */
+static int
+emmc_cmd(uint32_t idx, uint32_t arg, uint32_t flags, uint32_t *resp)
+{
+	uint32_t st = 0;
+	if (emmc_idle(EM_CMD_INHIBIT)) {
+		return ETIMEDOUT;
+	}
+	ufs_wr(EM_INT_STAT, 0xffffffff);
+	ufs_wr(EM_ARG, arg);
+	ufs_wr(EM_XFER_CMD, (idx << 8 | flags) << 16);
+	int error = emmc_wait(EM_INT_CMD, 500ull * NSEC_PER_MSEC, &st);
+	ufs_wr(EM_INT_STAT, EM_INT_CMD);
+	if (error) {
+		emmc_reset_lines();
+		return error;
+	}
+	if (resp) {
+		*resp = ufs_rd(EM_RESP0);
+	}
+	if ((flags & 3) == EM_R48B) {
+		emmc_busy_end();
+	}
+	return 0;
+}
+
+/* SD clock = base / (2 * div) (div 0 = base). */
+static void
+emmc_set_clock(uint32_t div)
+{
+	uint32_t c = ufs_rd(EM_CLOCK) & ~0xffffu;
+	ufs_wr(EM_CLOCK, c | (div & 0xff) << 8 | ((div >> 8) & 3) << 6 | 1);
+	for (int i = 0; i < 100000 && !(ufs_rd(EM_CLOCK) & 2); i++) {
+		delay(1);
+	}
+	ufs_wr(EM_CLOCK, ufs_rd(EM_CLOCK) | 4);
+	delay(1000);
+}
+
+/*
+ * count 512-byte blocks at lba, to/from the bounce buffer. Writes have
+ * already been bounds-checked by ufs_write_blocks, the only caller with
+ * write set.
+ */
+static int
+emmc_rw(uint64_t lba, uint32_t count, bool write)
+{
+	struct em_desc *d = (struct em_desc *)(su.dma + DMA_UTRL);
+	uint32_t bytes = count * 512u, n = 0, st = 0, resp;
+
+	if (count == 0 || count > 0xffff || bytes > BOUNCE_SIZE || lba > UINT32_MAX) {
+		return EINVAL;
+	}
+	for (uint32_t off = 0; off < bytes; off += EM_ADMA_CHUNK, n++) {
+		uint32_t len = MIN(EM_ADMA_CHUNK, bytes - off);
+		d[n].attr = 0x21 | (off + len >= bytes ? 2 : 0);       /* valid, tran, end */
+		d[n].len = (uint16_t)len;
+		d[n].addr = (uint32_t)(su.dma_pa + DMA_BOUNCE + off);
+	}
+	dma_clean(DMA_UTRL, n * sizeof(*d));
+	if (write) {
+		dma_clean(DMA_BOUNCE, bytes);
+	} else {
+		dma_sync(DMA_BOUNCE, bytes);
+	}
+	__builtin_arm_dsb(0xf);
+
+	if (emmc_idle(EM_CMD_INHIBIT | EM_DAT_INHIBIT)) {
+		emmc_reset_lines();
+		return ETIMEDOUT;
+	}
+	ufs_wr(EM_HOSTCTL, (ufs_rd(EM_HOSTCTL) & ~(3u << 3)) | (2u << 3));     /* ADMA2 32-bit */
+	ufs_wr(EM_ADMA_LO, (uint32_t)(su.dma_pa + DMA_UTRL));
+	ufs_wr(EM_ADMA_HI, 0);
+	ufs_wr(EM_INT_STAT, 0xffffffff);
+	ufs_wr(EM_BLOCK, (count << 16) | 512u);
+	ufs_wr(EM_ARG, (uint32_t)lba);
+	uint32_t cmd = write ? 25 : 18;
+	ufs_wr(EM_XFER_CMD, ((cmd << 8 | EM_R48 | EM_CRC | EM_IDX | EM_DATA) << 16) |
+	    EM_M_DMA | EM_M_BLKCNT | EM_M_ACMD12 | EM_M_MULTI | (write ? 0 : EM_M_READ));
+	int error = emmc_wait(EM_INT_XFER, CMD_TIMEOUT_NS, &st);
+	resp = ufs_rd(EM_RESP0);
+	ufs_wr(EM_INT_STAT, 0xffffffff);
+	__builtin_arm_dsb(0xf);
+	if (!write) {
+		dma_sync(DMA_BOUNCE, bytes);
+	}
+	if (error || (resp & EM_R1_ERRORS)) {
+		printf("SWEET EMMC: CMD%u lba 0x%llx x%u failed: error %d status 0x%x resp 0x%x\n",
+		    cmd, lba, count, error, st, resp);
+		emmc_reset_lines();
+		return error ? error : EIO;
+	}
+	return 0;
+}
+
+/* Flush the card's volatile cache (EXT_CSD FLUSH_CACHE); harmless if it is off. */
+static int
+emmc_flush(void)
+{
+	uint32_t resp = 0;
+	return emmc_cmd(6, 3u << 24 | 32u << 16 | 1u << 8, EM_R48B | EM_CRC | EM_IDX, &resp);
+}
+
+/* The msm core waits for software to confirm bus power requests. */
+static void
+emmc_pwrctl_ack(void)
+{
+	for (int i = 0; i < 100000; i++) {
+		uint32_t st = ufs_rd(EM_PWRCTL_STAT);
+		if (st) {
+			ufs_wr(EM_PWRCTL_CLEAR, st);
+			ufs_wr(EM_PWRCTL_CTL, ((st & 3) ? 1u : 0u) | ((st & 0xc) ? 4u : 0u));
+			return;
+		}
+		delay(1);
+	}
+}
+
+static int
+emmc_init_card(void)
+{
+	uint32_t ver = ufs_rd(EM_VERSION), resp = 0, ocr = 0;
+	if (ver == 0 || ver == 0xffffffff) {
+		printf("SWEET EMMC: host registers read 0x%x\n", ver);
+		return ENXIO;
+	}
+	uint32_t base = (ufs_rd(EM_CAPS) >> 8) & 0xff;
+	ufs_wr(EM_INT_EN, 0xffff00ff & ~0x100u);   /* latch all but card interrupt */
+	ufs_wr(EM_SIG_EN, 0);                       /* polled */
+	ufs_wr(EM_INT_STAT, 0xffffffff);
+	uint32_t hc = ufs_rd(EM_HOSTCTL);
+	if (!(hc & (1u << 8))) {
+		ufs_wr(EM_HOSTCTL, (hc & ~0xff00u) | (0x0bu << 8));
+		emmc_pwrctl_ack();
+	}
+	ufs_wr(EM_HOSTCTL, ufs_rd(EM_HOSTCTL) & ~((1u << 5) | (1u << 2) | (1u << 1) | (3u << 3)));
+	ufs_wr(EM_CLOCK, (ufs_rd(EM_CLOCK) & ~(0xffu << 16)) | (0x0eu << 16));
+	emmc_set_clock((base ? base : 200) * 1000 / 800);       /* 400 kHz */
+
+	(void)emmc_cmd(0, 0, 0, NULL);
+	delay(2000);
+	for (int i = 0; i < 1000 && !(ocr & (1u << 31)); i++) {
+		if (emmc_cmd(1, 0x40ff8080, EM_R48, &ocr)) {
+			ocr = 0;
+		}
+		if (!(ocr & (1u << 31))) {
+			delay(1000);
+		}
+	}
+	if (!(ocr & (1u << 31))) {
+		printf("SWEET EMMC: card did not power up (ocr 0x%x)\n", ocr);
+		return ENXIO;
+	}
+	if (emmc_cmd(2, 0, EM_R136 | EM_CRC, NULL) ||
+	    emmc_cmd(3, 1u << 16, EM_R48 | EM_CRC | EM_IDX, NULL) ||
+	    emmc_cmd(7, 1u << 16, EM_R48B | EM_CRC | EM_IDX, NULL)) {
+		printf("SWEET EMMC: identification failed\n");
+		return EIO;
+	}
+	/* 8-bit bus, then high-speed timing; both are volatile card settings. */
+	if (emmc_cmd(6, 3u << 24 | 183u << 16 | 2u << 8, EM_R48B | EM_CRC | EM_IDX, &resp) == 0) {
+		ufs_wr(EM_HOSTCTL, ufs_rd(EM_HOSTCTL) | (1u << 5));
+	}
+	if (emmc_cmd(6, 3u << 24 | 185u << 16 | 1u << 8, EM_R48B | EM_CRC | EM_IDX, &resp) == 0) {
+		ufs_wr(EM_HOSTCTL, ufs_rd(EM_HOSTCTL) | (1u << 2));
+		emmc_set_clock(su.emmc_div);
+	}
+	(void)emmc_cmd(13, 1u << 16, EM_R48 | EM_CRC | EM_IDX, &resp);
+	printf("SWEET EMMC: host 0x%x ocr 0x%x state %u hostctl 0x%x clock 0x%x (div %u)\n",
+	    ver >> 16, ocr, (resp >> 9) & 0xf, ufs_rd(EM_HOSTCTL), ufs_rd(EM_CLOCK), su.emmc_div);
+	return ((resp >> 9) & 0xf) == 4 ? 0 : EIO;
+}
